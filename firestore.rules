rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validAuthenticatedExchangeRequest() {
      let d = request.resource.data;
      return request.auth != null
        && request.auth.token.email_verified == true
        && d.keys().hasAll(['trackingCode','direction','currency','amount','paymentMethod','contactMethod','contact','paymentAccount','note','affiliateCode','transactionReference','proofEmail','proofScreenshotUrl','proofFileName','uid','requestType','userEmail','status','createdAt','proofSubmittedAt'])
        && d.keys().hasOnly(['trackingCode','direction','currency','amount','paymentMethod','contactMethod','contact','paymentAccount','note','affiliateCode','transactionReference','proofEmail','proofScreenshotUrl','proofFileName','uid','requestType','userEmail','status','createdAt','proofSubmittedAt'])
        && d.trackingCode is string && d.trackingCode.matches('MET-[A-Z0-9]{6}')
        && d.direction in ['buy','sell','exchange']
        && d.currency in ['USD','USDT','BDT']
        && d.amount is number && d.amount > 0 && d.amount <= 1000000
        && d.paymentMethod in ['bKash','Nagad','Rocket','Upay','ePay','TunePay','Bank','Other']
        && d.contactMethod in ['whatsapp','telegram','email']
        && d.contact is string && d.contact.size() >= 5 && d.contact.size() <= 160
        && d.paymentAccount is string && d.paymentAccount.size() >= 3 && d.paymentAccount.size() <= 120
        && d.note is string && d.note.size() <= 500
        && d.affiliateCode is string && d.affiliateCode.size() <= 40
        && d.transactionReference is string && d.transactionReference.size() >= 1 && d.transactionReference.size() <= 160
        && d.proofEmail is string && d.proofEmail.size() <= 160
        && d.proofScreenshotUrl is string && d.proofScreenshotUrl.size() <= 2048
        && d.proofFileName is string && d.proofFileName.size() >= 1 && d.proofFileName.size() <= 200
        && d.uid == request.auth.uid
        && d.requestType == 'user'
        && d.userEmail == request.auth.token.email
        && d.status == 'pending'
        && d.createdAt == request.time
        && d.proofSubmittedAt == request.time;
    }
    match /exchangeRequests/{requestId} {
      allow create: if validAuthenticatedExchangeRequest();
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // FastMoney public account-code registry: unique code reservation.
    match /fastMoneyAccountIds/{accountCode} {
      allow get: if request.auth != null;
      allow list, create, update, delete: if false;
    }
    match /userProfiles/{userId} {
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.keys().hasOnly([
                      'uid','firstName','lastName','fullName','email','phone',
                      'country','countryCode','currencyCode','currencySymbol',
                      'emailVerified','phoneVerified','createdAt'
                    ])
                    && request.resource.data.keys().hasAll([
                      'uid','firstName','lastName','fullName','email','country',
                      'countryCode','currencyCode','currencySymbol','createdAt'
                    ])
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.createdAt == request.time;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'dateOfBirth','gender','address','city','state','postalCode'
                    ]);
      allow delete: if false;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // User-scoped financial data. A signed-in user can read only their own
    // account document and child records. All balance/ledger writes are server-only.
    match /wallets/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
    match /wallets/{userId}/{subcollection}/{documentId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /ledger/{userId}/entries/{entryId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /transactions/{userId}/items/{transactionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /depositRequests/{userId}/items/{requestId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /withdrawalRequests/{userId}/items/{requestId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /notifications/{userId}/items/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /wallets/{document=**} { allow read, write: if false; }
    match /ledger/{document=**} { allow read, write: if false; }
    match /rates/{document=**} { allow read, write: if false; }
    match /paymentMethods/{document=**} { allow read, write: if false; }
    match /currencies/{document=**} { allow read, write: if false; }
    match /adminRoles/{document=**} { allow read, write: if false; }
    match /auditLogs/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}